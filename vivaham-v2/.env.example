# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Login code by SMS (default) or WhatsApp. WhatsApp needs Twilio / Twilio Verify as the phone provider in Supabase.
# VITE_OTP_CHANNEL=whatsapp

# Usage statistics (PostHog). Leave empty = nothing is recorded. The key starts with phc_ and is safe to be public.
# VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxx
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Shown at the bottom of the privacy notice
# VITE_OPERATOR=Your name or company
# VITE_CONTACT=WhatsApp +91 ...
